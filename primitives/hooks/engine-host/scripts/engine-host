#!/usr/bin/env bash
# engine-host — agents should run on hive (a suggestion, never a refusal), whatever app is its window.
# Spec: ../HOOK.md
#   engine-host check                      exit 0 on the engine's host, 1 elsewhere (reason on stderr)
#   engine-host hook claude|codex|cursor   before-tool guard; harness JSON on stdin
# Allows on its own failure. Refuses only on a positive finding.

# The engine's host, by its kernel hostname. Rivet's sandboxed workers share it, so they pass.
ENGINE_HOST="${ENGINE_HOST:-optimistic-wiles.hivelocitydns.com}"
ENGINE_SSH="${ENGINE_SSH:-hive}"

on_engine_host() { [ "$(uname -n 2>/dev/null)" = "$ENGINE_HOST" ]; }

ELSEWHERE_MSG="engine-host: this agent is running on $(uname -n 2>/dev/null), not on hive. \
Every agent runs on hive, where the Rivet engine is; the app you see it in (Rex, T3, Claude \
Desktop, a terminal) is only the window. Quit and start it on hive: type its name in a shell on \
this Mac (it opens on hive), or run 'ssh -t $ENGINE_SSH <agent> [args]'. Reach this Mac from hive \
with 'ssh m5 <cmd>'."

# Recognize screen reads in command position. Check only native Rex metadata:
# registered panes and harness status/process identities are agent screens.
rex_capture_refused() {
  # shellcheck disable=SC2016 # the Python program is single-quoted on purpose
  python3 -c '
import json, os, re, shlex, subprocess, sys

try:
    lex = shlex.shlex(sys.stdin.read(), posix=True, punctuation_chars="();<>|&\n")
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    tokens = [word.lstrip("`") for word in lex]
except ValueError:
    sys.exit(1)

def boundary(word):
    return bool(re.fullmatch(r"[();<>|&\n]+", word))

def literal(word):
    value = word
    for name in ("REX_SESSION", "REX_BLOCK", "LC_REX_SESSION", "LC_REX_BLOCK"):
        if word in ("$" + name, "${" + name + "}"):
            value = os.environ.get(name, "")
    if not value or any(c in value for c in "$`\n\r"):
        raise ValueError("target must be identifiable before capture")
    return value

def api(rex, rpc, **params):
    return run_json(rex + ["api", "call", rpc, json.dumps(params)])

def run_json(argv):
    result = subprocess.run(argv, capture_output=True, text=True, check=True, timeout=1.2)
    return json.loads(result.stdout)

def is_harness(name):
    return isinstance(name, str) and bool(re.search(
        r"(?:^|/)(?:claude(?:-code)?|codex|pi(?:-coding-agent)?)(?:/|$)|^\d+\.\d+\.\d+$",
        name.lower()))

def refuse(rex, target):
    try:
        found = run_json(rex + ["block", "inspect", "--json"] + target)
        sid, block = found["session_id"], found["block"]
        bid = block["block_id"]
        if not re.fullmatch(r"session:[0-9a-f-]+", sid) or not re.fullmatch(r"block:[0-9a-f-]+", bid):
            return True
        identity = subprocess.run(["agent-state", "bound", sid, bid], capture_output=True, timeout=1.2)
        if identity.returncode != 1 or block.get("label") in ("seat", "hive-oracle", "rex-oracle", "rivet-oracle"):
            return True
        if block.get("creator_name") != "com.superlogical.terminal":
            return True
        args = dict(session_id=sid, block_id=bid)
        status = api(rex, "block.method", method="program_status", **args)
        if any(is_harness(row.get("app")) for row in status.get("records") or []):
            return True
        process = api(rex, "block.method", method="process", **args)
        return any(is_harness(info.get(field)) for info in
                   (process.get("foreground") or {}, process.get("child") or {})
                   for field in ("name", "argv0", "script"))
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return True

start = True
override = False
valued = {"-S", "--server", "-C", "--client", "--timeout", "--color"}
separators = {"{", "!", "then", "do", "else", "exec", "time", "sudo", "env", "$"}
for i, word in enumerate(tokens):
    if start and re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*=.*", word):
        override |= word.split("=", 1)[0] in {"REX_SERVER", "REX_SESSION", "REX_BLOCK", "REX_CLIENT", "HOME", "PATH"}
        continue
    command = os.path.basename(word)
    if start and command in ("rex", "agent-read"):
        end = next((k for k in range(i + 1, len(tokens)) if boundary(tokens[k])), len(tokens))
        args = tokens[i + 1:end]
        rex = ["rex", "--autostart=false"]
        target = []
        try:
            if command == "agent-read":
                if len(args) == 2:
                    target = ["-s", literal(args[0]), literal(args[1])]
                else:
                    continue
            else:
                j = 0
                while j < len(args) and args[j].startswith("-"):
                    flag = args[j].split("=", 1)[0]
                    j += 2 if args[j] in valued else 1
                    if flag in ("-S", "--server"):
                        rex += ["-S", literal(args[j - 1].split("=", 1)[-1])]
                    elif flag.startswith("-S"):
                        rex += ["-S", literal(flag[2:])]
                if args[j:j + 1] == ["block"]:
                    j += 1
                if args[j:j + 1] != ["capture"] or any(a in ("-h", "--help") for a in args):
                    continue
                j += 1
                while j < len(args):
                    flag, eq, value = args[j].partition("=")
                    j += 1
                    if flag in ("--trim", "--unwrap"):
                        continue
                    if flag in ("-s", "--session", "-b", "--block", "-w", "--window", "--format", "-S", "--server"):
                        if not eq:
                            value = args[j]
                            j += 1
                        if flag in ("-S", "--server"):
                            rex += ["-S", literal(value)]
                        elif flag != "--format":
                            target += [literal(value)] if flag in ("-b", "--block") else [flag, literal(value)]
                    else:
                        raise ValueError("unrecognized capture selector")
            if override or refuse(rex, target):
                sys.exit(0)
        except (IndexError, ValueError):
            sys.exit(0)
        start = False
        continue
    if start and word in separators:
        continue
    start = boundary(word) or word in separators
    override = False
sys.exit(1)
' 2>/dev/null
}

# pause_command: exit 0 when the shell command on stdin runs kill, pkill or killall (in command
# position) with a stop signal: -STOP -SIGSTOP -19 -TSTP -SIGTSTP -20, -s/--signal STOP|TSTP|19|20.
# Quoted text is one token, so a message or commit text that mentions them never matches.
pause_command() {
  # shellcheck disable=SC2016 # the Python program is single-quoted on purpose
  python3 -c '
import os, re, shlex, sys
try:
    lex = shlex.shlex(sys.stdin.read(), posix=True, punctuation_chars="();<>|&\n")
    lex.whitespace = " \t\r"; lex.whitespace_split = True
    toks = [t.lstrip("`") for t in lex]
except ValueError:
    sys.exit(1)
SEP = {";", "&&", "||", "|", "&", "(", "\n", "$(", "{", "!", "then", "do", "else", "exec", "time", "sudo", "env", "xargs"}
STOP = re.compile(r"^(sig)?(stop|tstp)$|^(19|20)$", re.I)
start = True
for i, t in enumerate(toks):
    if start and "=" in t and not t.startswith(("-", "=")):
        continue
    if start and os.path.basename(t) in ("kill", "pkill", "killall"):
        args = toks[i + 1:]
        for j, arg in enumerate(args):
            if arg in SEP:
                break
            if arg.startswith("-") and STOP.match(arg.lstrip("-")):
                sys.exit(0)
            if arg in ("-s", "--signal", "-n") and j + 1 < len(args) and STOP.match(args[j + 1]):
                sys.exit(0)
            if arg.startswith("--signal=") and STOP.match(arg.split("=", 1)[1]):
                sys.exit(0)
    start = t in SEP or t == "$"
sys.exit(1)
' 2>/dev/null
}

deny() { # $1 harness, $2 reason
  case "$1" in
    claude|codex) jq -n --arg r "$2" '{hookSpecificOutput:{hookEventName:"PreToolUse",
                    permissionDecision:"deny", permissionDecisionReason:$r}}' ;;
    cursor) jq -n --arg r "$2" '{permission:"deny", user_message:$r, agent_message:$r}' ;;
  esac
  exit 0
}

case "${1:-}" in
  check)
    on_engine_host && exit 0
    echo "$ELSEWHERE_MSG" >&2; exit 1 ;;
  hook)
    harness="${2:-claude}"
    command -v jq >/dev/null 2>&1 || exit 0
    input=$(cat) || exit 0
    tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null)
    case "$tool" in
      Agent|Task|Workflow)
        # A harness's own sub-agent is allowed when it works in the system (Josh, 2026-11-23): its brief
        # names the task it picks up and the contractor rulebook. A page fetch is a tool, not a contractor.
        sub_type=$(printf '%s' "$input" | jq -r '.tool_input.subagent_type // empty' 2>/dev/null)
        brief=$(printf '%s' "$input" | jq -r '[.tool_input.prompt, .tool_input.script, .tool_input.args] | map(tostring) | join("\n")' 2>/dev/null)
        if [ "$sub_type" = "web-fetch" ] || { printf '%s' "$brief" | grep -Eq '^[[:space:]]*(//[[:space:]]*|#[[:space:]]*)?Task: *[A-Za-z0-9][A-Za-z0-9_:.-]*' \
             && printf '%s' "$brief" | grep -q 'CONTRACTOR.md'; }; then exit 0; fi
        deny "$harness" "engine-host: a sub-agent may run only inside the system (Josh, 2026-11-23). \
Its brief must name the task it picks up ('Task: <key>') and the rulebook (~/rivet/CONTRACTOR.md): it answers NQ on that task, \
writes to the task's streams, and talks to other agents only through Rex. Or start it as its own Rex agent with start-work." ;;
    esac
    cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // empty' 2>/dev/null) || exit 0
    [ -n "$cmd" ] || exit 0
    if [ "${MW_WORKER:-}" != 1 ] && printf '%s' "$cmd" | pause_command; then
      deny "$harness" "engine-host: agents are never paused (Josh, 2026-11-20): no SIGSTOP or SIGTSTP. \
A paused program reads nothing and every message to it piles up unseen. To stop an agent's work, \
tell it with agent-send; to end it, close its pane with agent-close."
    fi
    if printf '%s' "$cmd" | rex_capture_refused; then
      deny "$harness" "engine-host: never read a screen to wait on or check an agent. \
An agent's message wakes you; its state is its Program Status record: \
rex do com.superlogical.terminal.program_status -b <block>. \
For a command you ran in a pane: rex wait <block> --for <duration>, then rex block call -b <block> process for its exit. \
For an ordinary command pane you started, use rex block capture -s <session> -b <block> with the literal IDs Rex returned."
    fi
    exit 0 ;;
  *)
    echo "usage: engine-host check | hook claude|codex|cursor" >&2; exit 2 ;;
esac
