#!/usr/bin/env bash
# engine-host — agents should run on hive (a suggestion, never a refusal), whatever app is its window.
# Spec: ../HOOK.md
#   engine-host check                      exit 0 on the engine's host, 1 elsewhere (reason on stderr)
#   engine-host hook claude|codex|cursor   before-tool guard; harness JSON on stdin
# Allows on its own failure. Refuses only on a positive finding.

# The engine's host, by its kernel hostname. Rivet's sandboxed workers share it, so they pass.
ENGINE_HOST="${ENGINE_HOST:-optimistic-wiles.hivelocitydns.com}"
ENGINE_SSH="${ENGINE_SSH:-hive}"

on_engine_host() { [ "$(uname -n 2>/dev/null)" = "$ENGINE_HOST" ]; }

ELSEWHERE_MSG="engine-host: this agent is running on $(uname -n 2>/dev/null), not on hive. \
Every agent runs on hive, where the Rivet engine is; the app you see it in (Rex, T3, Claude \
Desktop, a terminal) is only the window. Quit and start it on hive: type its name in a shell on \
this Mac (it opens on hive), or run 'ssh -t $ENGINE_SSH <agent> [args]'. Reach this Mac from hive \
with 'ssh m5 <cmd>'."

# rex_capture_command: exit 0 when the shell command on stdin runs `rex [global options] capture` or
# `rex [global options] block capture` as a command: at the start, or after ; && || | & ( newline $( or `.
# Quoted text is one token, so a message that mentions those words never matches. A command the
# tokenizer cannot read (an unclosed quote) does not match: the guard's own failure allows.
rex_capture_command() {
  # shellcheck disable=SC2016 # the Python program is single-quoted on purpose
  python3 -c '
import os, shlex, sys
try:
    lex = shlex.shlex(sys.stdin.read(), posix=True, punctuation_chars="();<>|&\n")
    lex.whitespace = " \t\r"; lex.whitespace_split = True
    toks = [t.lstrip("`") for t in lex]
except ValueError:
    sys.exit(1)
SEP = {";", "&&", "||", "|", "&", "(", "\n", "$(", "{", "!", "then", "do", "else", "exec", "time", "sudo", "env"}
VALUED = {"-S", "--server", "-C", "--client", "--timeout", "--color"}
start = True
for i, t in enumerate(toks):
    if start and "=" in t and not t.startswith(("-", "=")):
        continue                                    # VAR=value before the command
    if start and t and os.path.basename(t) == "rex":
        j = i + 1
        while j < len(toks) and toks[j].startswith("-"):
            j += 2 if (toks[j] in VALUED and "=" not in toks[j]) else 1
        rest = toks[j:j + 2]
        if rest[:1] == ["capture"] or rest == ["block", "capture"]:
            sys.exit(0)
    start = t in SEP or t.endswith(("$(",)) or t == "$"
    if t == "$" and i + 1 < len(toks) and toks[i + 1] == "(":
        start = True
sys.exit(1)
' 2>/dev/null
}

deny() { # $1 harness, $2 reason
  case "$1" in
    claude|codex) jq -n --arg r "$2" '{hookSpecificOutput:{hookEventName:"PreToolUse",
                    permissionDecision:"deny", permissionDecisionReason:$r}}' ;;
    cursor) jq -n --arg r "$2" '{permission:"deny", user_message:$r, agent_message:$r}' ;;
  esac
  exit 0
}

case "${1:-}" in
  check)
    on_engine_host && exit 0
    echo "$ELSEWHERE_MSG" >&2; exit 1 ;;
  hook)
    harness="${2:-claude}"
    command -v jq >/dev/null 2>&1 || exit 0
    input=$(cat) || exit 0
    tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null)
    case "$tool" in
      Agent|Task|Workflow)
        deny "$harness" "engine-host: every agent is visible as its own session; in-process subagents ($tool) are refused. \
Start it visibly: agent-spawn \"\$REX_SESSION\" <name> -- <agent command...> (e.g. -- claude --dangerously-skip-permissions '<brief>'). \
It reports back to you through agent-send." ;;
    esac
    cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // empty' 2>/dev/null) || exit 0
    [ -n "$cmd" ] || exit 0
    if command -v teerex >/dev/null 2>&1 && printf '%s' "$cmd" | rex_capture_command; then
      deny "$harness" "engine-host: read terminals with teerex named hosts. \
Run teerex --config ~/.config/teerex/hosts.json --host m5 observe --session <session> --block <block>. \
Use --host hive for the rivet session; m5 for the operator's panes. \
For a change, save the observation then use teerex watch --baseline FILE --timeout-ms N."
    fi
    exit 0 ;;
  *)
    echo "usage: engine-host check | hook claude|codex|cursor" >&2; exit 2 ;;
esac
