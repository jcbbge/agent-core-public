#!/usr/bin/env bash
# mac-cdp — open the Mac browser's CDP port on this server for one task, run it, close the port.
#
#   mac-cdp <command...>        e.g.  mac-cdp node scripts/cdp.mjs <<'JS' ... JS
#
# At rest nothing on the server can reach the Mac's browser. For the length of <command>, the
# server's 127.0.0.1:${CDP_LOCAL_PORT:-9222} carries to the Mac's 127.0.0.1:${MAC_CDP_PORT:-9223},
# over ssh to ${OPERATOR_MAC_HOST:-m5}. If the port is already open (another task holds it), the
# command runs on that one and mac-cdp leaves it for its owner to close.
set -u
host=${OPERATOR_MAC_HOST:-m5}; mport=${MAC_CDP_PORT:-9223}; lport=${CDP_LOCAL_PORT:-9222}
up() { curl -s -m 1 -o /dev/null "http://127.0.0.1:$lport/json/version"; }
[ $# -gt 0 ] || { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
if up; then "$@"; exit $?; fi
ssh -N -o ExitOnForwardFailure=yes -o ControlMaster=no -o ControlPath=none -o BatchMode=yes \
  -L "127.0.0.1:$lport:127.0.0.1:$mport" "$host" &
pid=$!
trap 'kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null' EXIT
trap 'exit 130' INT TERM
for _ in $(seq 50); do
  up && break
  kill -0 "$pid" 2>/dev/null || { echo "mac-cdp: could not open the port to $host" >&2; exit 1; }
  sleep 0.2
done
up || { echo "mac-cdp: the Mac's browser is not answering on its port $mport; start it on the Mac" >&2; exit 1; }
"$@"
