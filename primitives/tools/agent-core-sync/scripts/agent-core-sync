#!/usr/bin/env bash
# agent-core-sync [--check]: this machine's agents load exactly what agent-core says. Spec: ../TOOL.md
set -euo pipefail
# Rex config belongs to ~/rexconfig (its ./install manages it).
AC="${AGENT_CORE:-$HOME/agent-core}"
CHECK=false; [ "${1:-}" = --check ] && CHECK=true

if ! $CHECK && [ -z "${AGENT_CORE_FROM_HOOK:-}" ]; then
  git -C "$AC" pull -q --ff-only 2>&1 || echo "agent-core-sync: $AC not fast-forwarded (dirty or diverged); writing from what is checked out" >&2
fi

body() { # a directive without its frontmatter
  awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; next} !fm' "$1"
}
rev=$(git -C "$AC" rev-parse --short HEAD)
want=$(printf '%s\n%s\n\n%s\n\n%s\n' \
  "<!-- Generated by agent-core-sync from agent-core $rev (primitives/directives/global + estate). Never edit here: change agent-core, push, run agent-core-sync. -->" \
  "" "$(body "$AC/primitives/directives/global/DIRECTIVE.md")" "$(body "$AC/primitives/directives/estate/DIRECTIVE.md")")

stale=0
for pair in ".claude:CLAUDE.md" ".codex:AGENTS.md" ".pi/agent:AGENTS.md" ".config/opencode:AGENTS.md" ".gemini:GEMINI.md"; do
  dir="$HOME/${pair%%:*}"; f="$dir/${pair##*:}"
  [ -d "$dir" ] || continue
  # Compare without the header line: the revision changes on every commit, the instructions may not.
  if [ -f "$f" ] && [ ! -L "$f" ] && diff -q <(tail -n +2 "$f") <(printf '%s\n' "$want" | tail -n +2) >/dev/null; then continue; fi
  if $CHECK; then echo "stale: $f"; stale=1; continue; fi
  [ -L "$f" ] && rm -f "$f"
  printf '%s\n' "$want" > "$f.tmp.$$" && mv "$f.tmp.$$" "$f"
  echo "wrote $f"
done

if [ -d "$HOME/.claude" ]; then
  mkdir -p "$HOME/.claude/rules"
  for r in "$AC"/primitives/rules/*/RULE.md; do
    n=$(basename "$(dirname "$r")"); l="$HOME/.claude/rules/$n.md"
    [ "$(readlink "$l" 2>/dev/null)" = "$r" ] && continue
    if $CHECK; then echo "stale: $l"; stale=1; continue; fi
    ln -sfn "$r" "$l"; echo "linked $l"
  done
  # A link we made to a rule that no longer exists goes with it.
  for l in "$HOME"/.claude/rules/*.md; do
    case "$(readlink "$l" 2>/dev/null)" in "$AC"/primitives/rules/*) ;; *) continue;; esac
    [ -e "$l" ] && continue
    if $CHECK; then echo "stale: $l"; stale=1; continue; fi
    rm -f "$l"; echo "removed $l"
  done
fi
# Commands: each primitives/commands/<name>/COMMAND.md, in the form each installed harness takes.
# A link we made is one that points into $CMDS; only those are ever removed.
CMDS="$AC/primitives/commands"
ours() { case "$(readlink "$1" 2>/dev/null)" in "$CMDS"/*) return 0;; esac; return 1; }
want_link() { # want_link <link> <target>
  [ "$(readlink "$1" 2>/dev/null)" = "$2" ] && return 0
  if [ -e "$1" ] || [ -L "$1" ]; then ours "$1" || { echo "agent-core-sync: $1 is not ours; left alone" >&2; return 0; }; fi
  if $CHECK; then echo "stale: $1"; stale=1; return 0; fi
  mkdir -p "$(dirname "$1")"; ln -sfn "$2" "$1"; echo "linked $1"
}
drop() { # drop <link>: a link we made for a command that no longer applies
  if $CHECK; then echo "stale: $1"; stale=1; return 0; fi
  rm -f "$1"; echo "removed $1"
  case "$1" in */SKILL.md) rmdir "$(dirname "$1")" 2>/dev/null || true;; esac
}
# Codex 0.169 skips a SKILL.md that is a symlink (even inside a linked folder), so its command is a
# generated copy; the folder's .agent-core-command names the source and marks the folder as ours.
MARK=.agent-core-command
codex_ours() { case "$(cat "$1/$MARK" 2>/dev/null)" in "$CMDS"/*) return 0;; esac; ours "$1/SKILL.md"; }
want_copy() { # want_copy <folder> <source>
  if [ -f "$1/SKILL.md" ] && [ ! -L "$1/SKILL.md" ] && cmp -s "$1/SKILL.md" "$2" && [ "$(cat "$1/$MARK" 2>/dev/null)" = "$2" ]; then return 0; fi
  if $CHECK; then echo "stale: $1/SKILL.md"; stale=1; return 0; fi
  mkdir -p "$1"; rm -f "$1/SKILL.md"
  cp "$2" "$1/SKILL.md.tmp.$$" && mv "$1/SKILL.md.tmp.$$" "$1/SKILL.md"; printf '%s\n' "$2" > "$1/$MARK"
  echo "wrote $1/SKILL.md"
}
drop_copy() { # drop_copy <folder>
  if $CHECK; then echo "stale: $1/SKILL.md"; stale=1; return 0; fi
  rm -f "$1/SKILL.md" "$1/$MARK"; rmdir "$1" 2>/dev/null || true; echo "removed $1/SKILL.md"
}
skill_named() { # skill_named <name> <dir>...: a skill of that name that is not one of our commands
  local n=$1 d; shift
  for d in "$@"; do [ -e "$d/$n" ] && ! codex_ours "$d/$n" && ! ours "$d/$n/SKILL.md" && return 0; done; return 1
}
for c in "$CMDS"/*/COMMAND.md; do
  [ -f "$c" ] || continue
  n=$(basename "$(dirname "$c")")
  # Claude Code: /<name>; a linked skill of the same name already answers /<name>.
  if [ -d "$HOME/.claude" ]; then
    l="$HOME/.claude/commands/$n.md"
    if skill_named "$n" "$HOME/.claude/skills"; then if ours "$l"; then drop "$l"; fi; else want_link "$l" "$c"; fi
  fi
  # Codex (0.169 has no custom prompts): a skill, typed $<name>.
  if [ -d "$HOME/.codex" ]; then
    d="$HOME/.codex/skills/$n"
    if skill_named "$n" "$HOME/.codex/skills" "$HOME/.agents/skills"; then if codex_ours "$d"; then drop_copy "$d"; fi
    elif [ -e "$d" ] && ! codex_ours "$d"; then echo "agent-core-sync: $d is not ours; left alone" >&2
    else want_copy "$d" "$c"; fi
  fi
  # pi: /<name>.
  if [ -d "$HOME/.pi/agent" ]; then want_link "$HOME/.pi/agent/prompts/$n.md" "$c"; fi
done
# Links we made for commands that no longer exist, and Codex prompt links (a retired mechanism).
for l in "$HOME"/.claude/commands/*.md "$HOME"/.pi/agent/prompts/*.md; do
  if ours "$l" && [ ! -f "$l" ]; then drop "$l"; fi
done
for d in "$HOME"/.codex/skills/*/; do
  d=${d%/}; [ -L "$d" ] && continue
  if codex_ours "$d" && [ ! -f "$CMDS/$(basename "$d")/COMMAND.md" ]; then drop_copy "$d"; fi
done
for l in "$HOME"/.codex/prompts/*.md; do if ours "$l"; then drop "$l"; fi; done
$CHECK || rmdir "$HOME/.codex/prompts" 2>/dev/null || true
exit $stale
