#!/usr/bin/env bash
# Sync only the Rex/Rivet connection map; retire the old agent-process surface.
set -euo pipefail
AC="${AGENT_CORE:-$HOME/agent-core}"
CHECK=false; [ "${1:-}" = --check ] && CHECK=true
if ! $CHECK && [ -z "${AGENT_CORE_FROM_HOOK:-}" ]; then
  git -C "$AC" pull -q --ff-only 2>&1 || echo 'agent-core-sync: pull did not fast-forward; using checked-out revision' >&2
fi
body() { awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; next} !fm' "$1"; }
rev=$(git -C "$AC" rev-parse --short HEAD)
want=$(printf '%s\n\n%s\n\n%s\n' \
  "<!-- Generated by agent-core-sync from agent-core $rev (connection map only). -->" \
  "$(body "$AC/primitives/directives/global/DIRECTIVE.md")" \
  "$(body "$AC/primitives/directives/estate/DIRECTIVE.md")")
stale=0
remove_owned() {
  if $CHECK; then echo "stale: $1"; stale=1; else rm -f "$1"; echo "removed $1"; fi
}
for pair in '.claude:CLAUDE.md' '.codex:AGENTS.md' '.pi/agent:AGENTS.md' '.config/opencode:AGENTS.md' '.gemini:GEMINI.md' '.factory:AGENTS.md'; do
  dir="$HOME/${pair%%:*}"; file="$dir/${pair##*:}"
  [ -d "$dir" ] || continue
  if [ -f "$file" ] && [ ! -L "$file" ] && diff -q "$file" <(printf '%s\n' "$want") >/dev/null; then continue; fi
  if $CHECK; then echo "stale: $file"; stale=1; continue; fi
  if [ -e "$file" ] || [ -L "$file" ]; then
    case "$(head -1 "$file" 2>/dev/null || true)" in '<!-- Generated by agent-core-sync'* ) ;; *) echo "not owned: $file" >&2; continue;; esac
  fi
  printf '%s\n' "$want" > "$file.tmp.$$" && mv "$file.tmp.$$" "$file"
  echo "wrote $file"
done
# Old rules, command shortcuts and skills were linked by this sync. Their source remains in Git,
# but none is loaded into a fresh agent automatically.
for link in "$HOME"/.claude/rules/*.md "$HOME"/.claude/commands/*.md \
            "$HOME"/.pi/agent/prompts/*.md \
            "$HOME"/.claude/skills/* "$HOME"/.codex/skills/* "$HOME"/.pi/agent/skills/*; do
  [ -L "$link" ] || continue
  target=$(readlink "$link")
  case "$target" in
    "$AC"/primitives/rules/*|"$AC"/primitives/commands/*|"$AC"/primitives/skills/*)
      remove_owned "$link";;
  esac
done
for folder in "$HOME"/.codex/skills/*; do
  [ -d "$folder" ] && [ ! -L "$folder" ] || continue
  marker="$folder/.agent-core-command"
  [ -f "$marker" ] || continue
  case "$(head -1 "$marker")" in "$AC"/primitives/commands/*)
    if $CHECK; then echo "stale: $folder/SKILL.md"; stale=1
    else rm -f "$folder/SKILL.md" "$marker"; rmdir "$folder" 2>/dev/null || true; echo "removed $folder/SKILL.md"; fi;;
  esac
done
exit "$stale"
