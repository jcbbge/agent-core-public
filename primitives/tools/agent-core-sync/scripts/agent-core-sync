#!/usr/bin/env bash
# agent-core-sync [--check]: this machine's agents load exactly what agent-core says. Spec: ../TOOL.md
set -euo pipefail
# Rex and teerex config belongs to ~/rexconfig (its ./install manages it).
AC="${AGENT_CORE:-$HOME/agent-core}"
CHECK=false; [ "${1:-}" = --check ] && CHECK=true

if ! $CHECK && [ -z "${AGENT_CORE_FROM_HOOK:-}" ]; then
  git -C "$AC" pull -q --ff-only 2>&1 || echo "agent-core-sync: $AC not fast-forwarded (dirty or diverged); writing from what is checked out" >&2
fi

body() { # a directive without its frontmatter
  awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; next} !fm' "$1"
}
rev=$(git -C "$AC" rev-parse --short HEAD)
want=$(printf '%s\n%s\n\n%s\n\n%s\n' \
  "<!-- Generated by agent-core-sync from agent-core $rev (primitives/directives/global + estate). Never edit here: change agent-core, push, run agent-core-sync. -->" \
  "" "$(body "$AC/primitives/directives/global/DIRECTIVE.md")" "$(body "$AC/primitives/directives/estate/DIRECTIVE.md")")

stale=0
for pair in ".claude:CLAUDE.md" ".codex:AGENTS.md" ".pi/agent:AGENTS.md" ".config/opencode:AGENTS.md" ".gemini:GEMINI.md"; do
  dir="$HOME/${pair%%:*}"; f="$dir/${pair##*:}"
  [ -d "$dir" ] || continue
  # Compare without the header line: the revision changes on every commit, the instructions may not.
  if [ -f "$f" ] && [ ! -L "$f" ] && diff -q <(tail -n +2 "$f") <(printf '%s\n' "$want" | tail -n +2) >/dev/null; then continue; fi
  if $CHECK; then echo "stale: $f"; stale=1; continue; fi
  [ -L "$f" ] && rm -f "$f"
  printf '%s\n' "$want" > "$f.tmp.$$" && mv "$f.tmp.$$" "$f"
  echo "wrote $f"
done

if [ -d "$HOME/.claude" ]; then
  mkdir -p "$HOME/.claude/rules"
  for r in "$AC"/primitives/rules/*/RULE.md; do
    n=$(basename "$(dirname "$r")"); l="$HOME/.claude/rules/$n.md"
    [ "$(readlink "$l" 2>/dev/null)" = "$r" ] && continue
    if $CHECK; then echo "stale: $l"; stale=1; continue; fi
    ln -sfn "$r" "$l"; echo "linked $l"
  done
fi
exit $stale
