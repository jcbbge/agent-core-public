#!/bin/bash
# rex-say <session> <block> <from> <message...>
# One agent-to-agent message, delivered whole: lock the receiving pane, clear its input line (a harness's
# greyed suggestion or a half-typed line), type "FROM <from>: <message>", press Enter, unlock.
# Concurrent senders to the same pane queue on the lock instead of running together (seen 2026-11-10).
# Runs where the Rex server is (the Mac). On a machine without it, the rex-say there forwards here.
set -euo pipefail
[ $# -ge 4 ] || { echo "usage: rex-say <session> <block> <from> <message...>" >&2; exit 2; }
S=$1; B=$2; FROM=$3; shift 3; MSG="$*"
REX=$(command -v rex || echo "/Users/jrg/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex")
LOCK="${TMPDIR:-/tmp}/rex-say.${B##*:}.lock"
for i in $(seq 1 300); do mkdir "$LOCK" 2>/dev/null && break; sleep 0.2; [ $i -eq 300 ] && { echo "rex-say: pane $B busy for 60s" >&2; exit 1; }; done
trap 'rmdir "$LOCK" 2>/dev/null' EXIT
"$REX" send-key -s "$S" -b "$B" ctrl+u >/dev/null 2>&1 || true
"$REX" send -s "$S" -b "$B" "FROM ${FROM}: ${MSG}"
sleep 0.3
"$REX" send-key -s "$S" -b "$B" Enter
