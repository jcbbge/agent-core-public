#!/usr/bin/env python3
"""agent-inbox [pane id] — the seat's inbox as a decision board, live.

Only what needs the human gets space. Open decisions (sent with agent-ask) are pinned at the top as full cards: the
ask, the context, each option with what you gain and what you lose, the recommendation, how to answer. Everything
else (status, reports, alerts) is one dim line in a short activity strip; handshakes (ACK) are not shown at all.
The screen redraws whenever the log changes. Ctrl+C to quit.

agent-send writes one JSON line per message ({at, from, msg}) to ~/.local/state/agent-inbox/<pane id>.log.
A decision is a message whose text starts DECISION-JSON:; DECISION-RESOLVED-JSON: clears it (agent-ask --resolve).
"""
import calendar, hashlib, json, os, re, shutil, sys, textwrap, time

DIR = os.environ.get("AGENT_INBOX_DIR", os.path.expanduser("~/.local/state/agent-inbox"))
ACTIVITY = int(os.environ.get("AGENT_INBOX_ACTIVITY", "6"))
MARK, RESOLVED = "DECISION-JSON:", "DECISION-RESOLVED-JSON:"

def pane_id():
    if len(sys.argv) > 1: return sys.argv[1].split(":")[-1]
    if os.environ.get("AGENT_INBOX_PANE"): return os.environ["AGENT_INBOX_PANE"].split(":")[-1]
    marks = [f[:-6] for f in os.listdir(DIR) if f.endswith(".inbox")]
    if len(marks) == 1: return marks[0]
    sys.exit("agent-inbox: name the pane (marked inboxes: %s)" % (", ".join(marks) or "none"))

TTY = sys.stdout.isatty()
def c(code, s): return f"\033[{code}m{s}\033[0m" if TTY else s
DIM, BOLD = "2", "1"
AMBER, GREEN, RED, CYAN = "38;5;221", "38;5;114", "38;5;203", "38;5;81"

def width():
    try: return max(40, os.get_terminal_size(sys.stdout.fileno()).columns)
    except OSError: return max(40, shutil.get_terminal_size((80, 24)).columns)

def local(at):
    if at.endswith("Z"):
        try: return time.strftime("%H:%M", time.localtime(calendar.timegm(time.strptime(at, "%Y-%m-%dT%H:%M:%SZ"))))
        except ValueError: pass
    m = re.search(r"(\d\d:\d\d)", at or ""); return m.group(1) if m else ""

def wrap(text, w, indent, first=None):
    out = []
    for i, para in enumerate(str(text).split("\n")):
        lines = textwrap.wrap(para, max(20, w - len(indent)), break_on_hyphens=False) or [""]
        for j, l in enumerate(lines):
            lead = first if (first is not None and i == 0 and j == 0) else indent
            out.append(lead + l)
    return out

def read(path):
    recs = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line: continue
            try: r = json.loads(line)
            except ValueError:
                m = re.match(r"(\d\d:\d\d:\d\d) FROM ([^:]+?): (.*)", line)
                r = {"at": m.group(1), "from": m.group(2), "msg": m.group(3)} if m else {"at": "", "from": "?", "msg": line}
            recs.append(r)
    return recs

def fold(recs):
    open_, done, activity = {}, [], []
    for r in recs:
        msg = re.sub(r"^FROM [^:]*:\s*", "", str(r.get("msg", "")).strip())
        if msg.startswith(MARK):
            try: d = json.loads(msg[len(MARK):]); d["at"], d["from"] = r.get("at", ""), r.get("from", "?"); open_[d["id"]] = d
            except ValueError: activity.append((r, "an unreadable decision (bad JSON)"))
        elif msg.startswith(RESOLVED):
            try:
                x = json.loads(msg[len(RESOLVED):]); d = open_.pop(x["id"], None)
                if d: done.append((d, x.get("answer", ""), r.get("at", "")))
            except ValueError: pass
        elif re.match(r"^ACK\b", msg) or re.match(r"^\S+: hi$", msg) or "proof" in str(r.get("from", "")).lower():
            continue  # handshakes and test/proof agents: never shown
        else:
            activity.append((r, msg))
    return list(open_.values()), done, activity

def card(d, w):
    o = []
    head = f" DECISION · {d.get('title','')} "
    o.append(c("1;30;48;5;221", head) + c(DIM, f"  {local(d['at'])} · from {d['from']} · id {d['id']}"))
    o += [c(BOLD, l) for l in wrap(d.get("ask", ""), w, "  ", "  ")]
    o.append("")
    o += [c(DIM, "  CONTEXT")] + wrap(d.get("context", ""), w, "    ")
    o.append("")
    o.append(c(DIM, "  OPTIONS"))
    for i, op in enumerate(d.get("options", [])):
        key = chr(65 + i)
        o.append("    " + c(BOLD + ";" + CYAN, f"{key}  {op['label']}"))
        o += [c(GREEN, l) for l in wrap(op["gain"], w, "         ", "       + ")]
        o += [c(RED, l) for l in wrap(op["lose"], w, "         ", "       − ")]
    o.append("")
    o += [c(AMBER, l) for l in wrap(d.get("recommend", ""), w, "               ", "  RECOMMEND    ")]
    ans = d.get("answer") or "type your choice in the left pane"
    o += [c(DIM, l) for l in wrap(ans, w, "               ", "  ANSWER       ")]
    return o

def first_line(msg, n):
    s = msg.split("\n", 1)[0].strip()
    return s if len(s) <= n else s[: n - 1] + "…"

def render(path):
    w = width()
    open_, done, activity = fold(read(path))
    if TTY: sys.stdout.write(f"\033]2;Inbox · {len(open_)} waiting\007")
    out = ["\033[2J\033[H" if TTY else ""]
    if open_:
        out.append(c(BOLD + ";" + AMBER, f"  {len(open_)} WAITING ON YOU"))
        out.append("")
        for d in open_:
            out += card(d, w); out.append(c(DIM, "  " + "─" * (w - 4))); out.append("")
    else:
        out.append(c(BOLD + ";" + GREEN, "  Nothing waiting on you."))
        out.append("")
    if done:
        for d, ans, at in done[-2:]:
            out.append(c(DIM, f"  ✓ {local(at)}  {d.get('title','')}: {ans}"))
        out.append("")
    if activity:
        out.append(c(DIM, "  RECENT ACTIVITY"))
        for r, msg in activity[-ACTIVITY:]:
            who = re.sub(r"\s*\(fenced.*\)$", "", r.get("from", "?"))
            out.append(c(DIM, f"  {local(r.get('at','')):>5}  ") + c(DIM + ";" + CYAN, who) + c(DIM, "  " + first_line(msg, w - len(who) - 12)))
    sys.stdout.write("\n".join(out) + "\n"); sys.stdout.flush()

def main():
    path = os.path.join(DIR, pane_id() + ".log")
    open(path, "a").close()
    last = None
    while True:
        try: st = os.stat(path); key = (st.st_size, st.st_mtime, width())
        except OSError: key = None
        if key != last:
            render(path); last = key
        if not TTY: return
        time.sleep(0.5)

if __name__ == "__main__":
    try: main()
    except KeyboardInterrupt: pass
