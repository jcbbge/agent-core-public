# shellcheck shell=bash disable=SC2034
# Shared named-host selection. No private socket forwarding or transport fallback.
TEEREX_HOSTS=${TEEREX_HOSTS:-$HOME/.config/teerex/hosts.json}

tx() { teerex --config "$TEEREX_HOSTS" --host "$WHERE" "$@"; }

host_info() {
  HOST_INFO=$(teerex targets resolve --config "$TEEREX_HOSTS" --host "$WHERE") || return
  STORE=$(printf '%s' "$HOST_INFO" | jq -er '.host.store') || return
  SOCK=$(printf '%s' "$HOST_INFO" | jq -er '.host.socket') || return
}

resolve() {
  local host out matches found='' found_host=''
  for host in hive m5; do
    WHERE=$host
    if ! out=$(tx boards probe); then
      echo "teerex-target: $host probe unavailable; checking the other host" >&2
      continue
    fi
    matches=$(printf '%s' "$out" | jq -r --arg s "$1" '[.rows[].session | select(.==$s or endswith(":"+$s))] | unique | .[]') || return
    if [ -n "$matches" ]; then
      [ -z "$found" ] && [ "$(printf '%s\n' "$matches" | wc -l)" -eq 1 ] || {
        echo "teerex-target: ambiguous session '$1'" >&2; return 1; }
      found=$matches; found_host=$host
    fi
  done
  if [ -z "$found" ]; then
    # no teerex verb: jcbbge/teerex#2 (session label/suffix lookup, including empty sessions).
    for host in hive m5; do
      WHERE=$host; host_info || continue
      if out=$(rexat session inspect "$1" --json 2>/dev/null); then
        [ -z "$found" ] || { echo "teerex-target: ambiguous session '$1'" >&2; return 1; }
        found=$(printf '%s' "$out" | jq -er '.session_id') || return
        found_host=$host
      fi
    done
  fi
  [ -n "$found" ] || { echo "teerex-target: no session '$1'" >&2; return 1; }
  SID=$found; WHERE=$found_host
  host_info
}

# no teerex verb: jcbbge/teerex#2 (session label/suffix lookup, including empty sessions).
# Only the unresolved session lookup uses Rex directly, pinned by the named-host record.
rexat() {
  local binary transport address port identity known command
  binary=$(printf '%s' "$HOST_INFO" | jq -er '.host.rex')
  transport=$(printf '%s' "$HOST_INFO" | jq -er '.host.transport')
  if [ "$transport" = local ]; then
    "$binary" --autostart=false --server "unix://$SOCK" "$@"
  else
    address=$(printf '%s' "$HOST_INFO" | jq -er '.host.address')
    port=$(printf '%s' "$HOST_INFO" | jq -er '.host.port')
    identity=$(printf '%s' "$HOST_INFO" | jq -er '.host.identity_file')
    known=$(printf '%s' "$HOST_INFO" | jq -er '.host.known_hosts')
    printf -v command '%q ' "$binary" --autostart=false --server "unix://$SOCK" "$@"
    ssh -F /dev/null -o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes \
      -o ForwardAgent=no -o ConnectTimeout=8 -o "UserKnownHostsFile=$known" -i "$identity" -p "$port" "$address" "$command"
  fi
}
