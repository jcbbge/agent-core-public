#!/usr/bin/env bash
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: agent-read <session> <pane>" >&2; exit 2; }
# shellcheck source=primitives/tools/agent-messaging/teerex-target
. "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")/teerex-target"
resolve "$1"
tx observe --session "$SID" --block "$2" --max-bytes 65536 | jq -er '.capture.content'
