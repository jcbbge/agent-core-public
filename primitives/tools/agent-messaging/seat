#!/usr/bin/env bash
# One pointer, held locked while checking/focusing or claiming the seat on hive.
set -euo pipefail
if [ "$(uname)" = Darwin ]; then
  export LC_REX_BLOCK=${REX_BLOCK:-} LC_REX_SESSION=${REX_SESSION:-}
  # shellcheck disable=SC2088 # Remote shell expands the home directory.
  exec ssh -t "${ENGINE_SSH:-hive}" '~/.local/bin/seat'
fi
B=${AGENT_PANE:-${REX_BLOCK:-${LC_REX_BLOCK:-}}}
S=${AGENT_SESSION:-${REX_SESSION:-${LC_REX_SESSION:-}}}
[ -n "$B" ] && [ -n "$S" ] || { echo "seat: start it in a Rex tab" >&2; exit 1; }
TEEREX_HOSTS=${TEEREX_HOSTS:-$HOME/.config/teerex/hosts.json}
WHERE=${TEEREX_HOST:-hive}
tx() { teerex --config "$TEEREX_HOSTS" --host "$WHERE" "$@"; }
SID=$(tx surfaces resolve --session "$S" | jq -er '.resolved.session_id')
CURRENT_HOST=$WHERE; CURRENT_SID=$SID
D=${SEAT_STATE_DIR:-$HOME/.local/state/agent-messaging}
mkdir -p "$D"
umask 077
exec 9>>"$D/current-seat"
flock -x -w 5 9 || { echo "seat: another seat check is running" >&2; exit 1; }
if read -r OLD_HOST OLD_S OLD_B < "$D/current-seat"; then
  case "$OLD_HOST" in m5|hive) ;; *) echo "seat: invalid seat pointer" >&2; exit 1 ;; esac
  WHERE=$OLD_HOST
  if OBS=$(tx observe --session "$OLD_S" --block "$OLD_B" --max-bytes 256); then
    FG=$(printf '%s' "$OBS" | jq -er '.process.data.foreground.name // .process.data.child.name')
    case "${FG##*/}" in
      zsh|bash|sh|-zsh|-bash|login) ;;
      *) tx surfaces focus --session "$OLD_S" --pane "$OLD_B" >/dev/null
         echo 'The seat is already open. Switched to it.'
         exit 0 ;;
    esac
  else
    # Unknown reads do not authorize another seat. Confirm absence separately.
    PROBE=$(tx boards probe)
    if printf '%s' "$PROBE" | jq -e --arg s "$OLD_S" --arg b "$OLD_B" '.rows[] | select(.session==$s and .block==$b)' >/dev/null; then
      echo "seat: current seat exists but cannot be observed; no new seat started" >&2; exit 1
    fi
  fi
fi
WHERE=$CURRENT_HOST; SID=$CURRENT_SID
W=$(tx boards probe | jq -er --arg b "$B" '.rows[] | select(.block==$b) | .window_id')
tx surfaces rename --session "$SID" --window "$W" --label seat >/dev/null
printf '%s %s %s\n' "$WHERE" "$SID" "$B" > "$D/current-seat"
flock -u 9
exec 9>&-
cd "$HOME"
exec "$HOME/.local/bin/claude" --dangerously-skip-permissions \
  "You are the seat. Read $(dirname "$(readlink -f "$0")")/SEAT.md and follow it. Your pane is $B in session $SID."
