#!/usr/bin/env bash
# Native server-wide ensure owns seat lookup, serialization, reuse and focus.
set -euo pipefail
TX=(teerex --config "${TEEREX_HOSTS:-$HOME/.config/teerex/hosts.json}" --host hive)
if [ "${1:-}" = --run ]; then
  S=${REX_SESSION:?seat needs its native Rex session}
  B=${REX_BLOCK:?seat needs its native Rex pane}
  "${TX[@]}" seat register --session "$S" --block "$B" --owner seat >/dev/null
  cd "$HOME"
  exec "$HOME/.local/bin/claude" --dangerously-skip-permissions \
    "You are the seat. Read $(dirname "$(readlink -f "$0")")/SEAT.md and follow it. Your pane is $B in session $S."
fi
# shellcheck disable=SC2016 # The selected host expands its own HOME.
exec "${TX[@]}" surfaces ensure --session any --label seat \
  --create-session "${SEAT_SESSION:-rivet}" --focus yes --layout tab -- \
  bash -lc 'exec "$HOME/.local/bin/seat" --run'
