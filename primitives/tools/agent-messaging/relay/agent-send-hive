#!/usr/bin/env bash
# agent-send on a worker host (hive). Usage: agent-send <session> <block> <name> <message>
# Inside a fence (RV_RELAY_MAILBOX set to a writable folder) there is no key and no tunnel: the message is written to
# the mailbox as one JSON file and the agent-relay service delivers it. Otherwise it forwards to the operator's
# machine, where the terminal multiplexer and the per-pane lock live (agent-core tools/agent-messaging).
if [ -n "${RV_RELAY_MAILBOX:-}" ] && [ -d "$RV_RELAY_MAILBOX" ] && [ -w "$RV_RELAY_MAILBOX" ]; then
  [ $# -ge 4 ] || { echo "usage: agent-send <session> <block> <name> <message>" >&2; exit 2; }
  f="$RV_RELAY_MAILBOX/$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM.json"
  jq -n --arg s "$1" --arg b "$2" --arg n "$3" --arg m "$4" --arg i "${RV_ITEM:-}" \
     '{session:$s, block:$b, name:$n, message:$m, item:$i, at:(now|todate)}' > "$f.tmp" && mv "$f.tmp" "$f" && exit 0
  echo "agent-send: could not write to the mailbox $RV_RELAY_MAILBOX" >&2; exit 1
fi
# Inbox panes live here on hive: a pane a human types in (the seat) is never typed into. If $INBOX/<pane id>.inbox
# exists, the message is appended whole, newlines kept, as one JSON line to $INBOX/<pane id>.log; `agent-inbox`
# renders it. Fenced workers reach this through the relay above, which calls this same command.
INBOX="${AGENT_INBOX_DIR:-$HOME/.local/state/agent-inbox}"
if [ $# -ge 4 ] && [ -e "$INBOX/${2##*:}.inbox" ]; then
  id=${2##*:}; FROM=$3; shift 3
  jq -nc --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg from "$FROM" --arg msg "$*" '{at:$at, from:$from, msg:$msg}' >> "$INBOX/$id.log"
  exit 0
fi
args=$(printf " %q" "$@")
exec ssh -o BatchMode=yes -o ConnectTimeout=8 m5 "PATH=\$HOME/.local/bin:\$PATH agent-send$args"
