#!/usr/bin/env bash
# agent-relay: the one always-on relay on a worker host (hive) that carries fenced workers' messages to their starters.
# A fenced worker has no key and no tunnel. It runs `agent-send`, which (with RV_RELAY_MAILBOX set) writes one JSON
# file into the mailbox instead of reaching the operator's machine. This service watches the mailbox and delivers each
# file with the real `agent-send`, to allowlisted panes only, then moves the file to sent/ or failed/ and logs one line.
# State: $AGENT_RELAY (default ~/.local/state/agent-relay): outbox/ sent/ failed/ allow relay.log
# It changes nothing else on the machine. Off: systemctl --user stop agent-relay (disable to keep it off).
set -u
ROOT="${AGENT_RELAY:-$HOME/.local/state/agent-relay}"
OUT="$ROOT/outbox"; SENT="$ROOT/sent"; FAILED="$ROOT/failed"; ALLOW="$ROOT/allow"; LOG="$ROOT/relay.log"
mkdir -p "$OUT" "$SENT" "$FAILED"; touch "$ALLOW"
export PATH="$HOME/.local/bin:$PATH"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }
log "relay up, mailbox $OUT"
while :; do
  for f in "$OUT"/*.json; do
    [ -e "$f" ] || continue
    session=$(jq -r '.session // empty' "$f" 2>/dev/null); block=$(jq -r '.block // empty' "$f" 2>/dev/null)
    name=$(jq -r '.name // empty' "$f" 2>/dev/null); msg=$(jq -r '.message // empty' "$f" 2>/dev/null)
    item=$(jq -r '.item // empty' "$f" 2>/dev/null)
    if [ -z "$session" ] || [ -z "$block" ] || [ -z "$name" ] || [ -z "$msg" ]; then
      log "failed $(basename "$f"): malformed"; mv "$f" "$FAILED/"; continue; fi
    if ! grep -qxF -e "$block" -e '*' "$ALLOW"; then
      log "failed $(basename "$f"): block $block not in allow"; mv "$f" "$FAILED/"; continue; fi
    if agent-send "$session" "$block" "$name (fenced${item:+, $item})" "$msg" >>"$LOG" 2>&1; then
      log "sent $(basename "$f"): $name -> $block"; mv "$f" "$SENT/"
    else
      log "failed $(basename "$f"): agent-send error"; mv "$f" "$FAILED/"
    fi
  done
  sleep 1
done
