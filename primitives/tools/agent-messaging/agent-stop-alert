#!/usr/bin/env python3
"""agent-stop-alert: a spawned agent's harness calls this when a turn ends (Stop) or dies on an error (StopFailure).
It tells the agent's starter, by agent-send, that the agent has stopped and why, so no agent finishes or dies
silently. The agent does not have to remember to report; its launcher made sure it would.

Who to tell comes from the environment agent-spawn set: AGENT_REPORT_TO="<session> <pane>" and AGENT_NAME (or the
LC_ forms, which cross ssh). No starter set means a human started this session: do nothing.
Reads the hook's JSON on stdin. Never blocks the agent: always exits 0.
"""
import json, os, subprocess, sys

def env(k): return os.environ.get(k) or os.environ.get("LC_" + k) or ""

def last_text(transcript):
    try:
        lines = open(transcript).read().splitlines()[-200:]
    except OSError:
        return ""
    for l in reversed(lines):
        try: r = json.loads(l)
        except ValueError: continue
        m = r.get("message") or {}
        if r.get("type") == "assistant" and isinstance(m.get("content"), list):
            t = " ".join(c.get("text", "") for c in m["content"] if c.get("type") == "text").strip()
            if t: return t
    return ""

def main():
    to = env("AGENT_REPORT_TO").split()
    if len(to) != 2: return
    name = env("AGENT_NAME") or "AGENT"
    try: h = json.load(sys.stdin)
    except ValueError: h = {}
    event = h.get("hook_event_name", "Stop")
    if event == "StopFailure":
        err = h.get("error") or h.get("error_details") or h.get("message") or "unknown error"
        msg = f"STOPPED ON AN ERROR: {name} died and cannot continue.\nError: {str(err)[:600]}\nIt needs a restart (another model, or the same brief again)."
    else:
        last = (h.get("last_assistant_message") or last_text(h.get("transcript_path", "")) or "").strip()
        msg = f"STOPPED: {name} finished its turn and is idle.\nIts last words:\n{last[:1500] or '(no text)'}"
    subprocess.run(["agent-send", to[0], to[1], f"{name} (auto)", msg], timeout=30, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    try: main()
    except Exception: pass
    sys.exit(0)
