#!/usr/bin/env bash
# Managed agent launch; arbitrary commands require --non-agent.
export TEEREX_CALLER=agent-spawn
set -euo pipefail
OWNER=${AGENT_NAME:-${LC_AGENT_NAME:-seat}}
PURPOSE=
BRIEF=
NON_AGENT=false
while [ $# -gt 0 ]; do
  case "$1" in
    --owner|--purpose|--brief-file)
      [ $# -ge 2 ] || { echo "agent-spawn: $1 needs text" >&2; exit 2; }
      case "$1" in --owner) OWNER=$2 ;; --purpose) PURPOSE=$2 ;; --brief-file) BRIEF=$2 ;; esac
      shift 2 ;;
    --non-agent) NON_AGENT=true; shift ;;
    --detached) echo "agent-spawn: detached agents are retired; start a visible tab" >&2; exit 2 ;;
    *) break ;;
  esac
done
[ $# -ge 4 ] && [ "$3" = -- ] || { echo "usage: agent-spawn [--owner TEXT] [--purpose TEXT] --brief-file FILE <session> <name> -- <claude|codex|pi> (or --non-agent ... -- <command...>)" >&2; exit 2; }
S=$1; N=$2; shift 3
PURPOSE=${PURPOSE:-$N}
REPORT="${AGENT_SESSION:-${REX_SESSION:-${LC_REX_SESSION:-}}} ${AGENT_PANE:-${REX_BLOCK:-${LC_REX_BLOCK:-}}}"
read -r RS RB EXTRA <<<"$REPORT"
[ -n "$RS" ] && [ -n "$RB" ] && [ -z "${EXTRA:-}" ] || { echo "agent-spawn: caller's own session and pane are required" >&2; exit 2; }
if [ "$NON_AGENT" = false ]; then
  [ $# -eq 1 ] || { echo "agent-spawn: agents take one profile (claude, codex or pi), not command arguments" >&2; exit 2; }
  case "$1" in claude|codex|pi) ;; *) echo "agent-spawn: unknown agent profile '$1'; use --non-agent for a non-agent command" >&2; exit 2 ;; esac
  [ -n "$BRIEF" ] && [ -f "$BRIEF" ] || { echo "agent-spawn: agents require --brief-file pointing to a brief file" >&2; exit 2; }
fi
TX=(teerex --config "${TEEREX_HOSTS:-$HOME/.config/teerex/hosts.json}" --host "${TEEREX_HOST:-hive}")
RSID=$("${TX[@]}" surfaces resolve --session "$RS" | jq -er '.resolved.session_id')
SID=$("${TX[@]}" surfaces resolve --session "$S" | jq -er '.resolved.session_id')
if [ "$NON_AGENT" = true ]; then
  # Low-level spawn is exclusively for an explicitly marked non-agent command.
  OUT=$("${TX[@]}" spawn --session "$SID" --name "$N" --cwd "$PWD" --report-to-session "$RSID" --report-to-block "$RB" -- "$@") || {
    echo "agent-spawn: creation not confirmed; inspect before retrying: $OUT" >&2; exit 1; }
  printf '%s\n' "$OUT" | jq -er '.created.block_id'
  exit
fi
# Profiles own harness argv, standing flags, registry and fleet-board store.
OUT=$("${TX[@]}" agents launch --config "${TEEREX_PROFILES:-$HOME/.config/teerex/profiles.json}" \
  --profile "$1" --ack-timeout-ms 60000 --session "$SID" --cwd "$PWD" \
  --starter-session "$RSID" --starter-block "$RB" \
  --report-to-session "$RSID" --report-to-block "$RB" \
  --name "$N" --owner "$OWNER" --purpose "$PURPOSE" --brief-file "$BRIEF") || {
  status=$?
  printf '%s\n' "$OUT" >&2
  echo "agent-spawn: managed launch not confirmed; inspect the tracked launch before retrying" >&2
  exit "$status"
}
printf '%s\n' "$OUT" >&2
printf '%s\n' "$OUT" | jq -er '.target.block_id'
