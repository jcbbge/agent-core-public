#!/bin/bash
# agent-send <session> <pane> <from> <message...>
# teerex owns serialization, draft protection, paste and Enter.
set -euo pipefail
[ $# -ge 4 ] || { echo "usage: agent-send <session> <pane> <from> <message...>" >&2; exit 2; }
S=$1; P=$2; FROM=$3; shift 3; MSG="$*"
# A fenced launch receives only its own delivery handle; never a Rex socket or shared mailbox.
CHANNEL=${AGENT_CHANNEL:-${LC_AGENT_CHANNEL:-}}
if [ -n "$CHANNEL" ]; then
  if [ "$S $P" = "${AGENT_REPORT_TO:-${LC_AGENT_REPORT_TO:-}}" ]; then
    DEST=report-to
  elif [ "$S $P" = "${AGENT_STARTER:-${LC_AGENT_STARTER:-}}" ]; then
    DEST=starter
  else
    echo "agent-send: destination is outside this launch's delivery channel" >&2
    exit 2
  fi
  REQUEST=$(python3 -c 'import secrets; print(secrets.token_hex(16))')
  printf '%s' "$MSG" | teerex agents channel --handle "$CHANNEL" --request-id "$REQUEST" \
    --operation send --to "$DEST" --message-file -
  exit $?
fi
TX=(teerex --config "${TEEREX_HOSTS:-$HOME/.config/teerex/hosts.json}" --host "${TEEREX_HOST:-hive}")
TARGET=$("${TX[@]}" surfaces resolve --session "$S" --pane "$P")
SID=$(printf '%s' "$TARGET" | jq -er '.resolved.session_id')
P=$(printf '%s' "$TARGET" | jq -er '.resolved.block_id')
OUT=$(printf '%s' "$MSG" | "${TX[@]}" send --session "$SID" --block "$P" --from "$FROM" --message-file -) || {
  echo "agent-send: teerex send did not confirm delivery to $P: $OUT. Inspect the pane before resending." >&2
  exit 1; }
