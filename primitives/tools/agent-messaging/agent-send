#!/bin/bash
# agent-send <session> <pane> <from> <message...>
# One agent-to-agent message, delivered whole: lock the receiving pane, clear its input line, type
# "FROM <from>: <message>", press Enter, unlock. Concurrent senders to one pane queue on the lock.
# Transport: the terminal multiplexer's CLI (today Rex), run where its server is. Elsewhere, a forwarder calls this.
set -euo pipefail
# Read only actual input, excluding dim and grey completion suggestions.
GUARD_PY=$(cat <<'PYGUARD'
import json,re,sys
try:
    text=json.load(sys.stdin)['text']
    lines=[line for line in text.splitlines() if re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '',line).strip()][-15:]
    draft=''
    for line in lines:
        plain=re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '',line)
        if not re.match(r'^\s*[│┃|]?\s*[>❯]\s?(.*?)\s*[│┃|]?\s*$', plain):
            continue
        dim=False; grey=False; out=[]
        for part in re.split(r'(\x1b\[[0-?]*[ -/]*[@-~])', line):
            if part.startswith('\x1b['):
                if not part.endswith('m'): continue
                codes=[int(c or 0) for c in part[2:-1].split(';')]
                i=0
                while i<len(codes):
                    c=codes[i]
                    if c==0: dim=grey=False
                    elif c==2: dim=True
                    elif c==22: dim=False
                    elif c==90: grey=True
                    elif c==39 or 30<=c<=37 or 91<=c<=97: grey=False
                    elif c==38 and i+2<len(codes) and codes[i+1]==5:
                        grey=240<=codes[i+2]<=250; i+=2
                    elif c==38 and i+4<len(codes) and codes[i+1]==2:
                        red,green,blue=codes[i+2:i+5]; grey=red==green==blue and red<160; i+=4
                    i+=1
            elif not dim and not grey: out.append(part)
        m=re.match(r'^\s*[│┃|]?\s*[>❯]\s?(.*?)\s*[│┃|]?\s*$', ''.join(out))
        draft=m.group(1).strip() if m else ''
    print(draft)
except (ValueError,KeyError,TypeError,AttributeError):
    pass
PYGUARD
)
if [ "${1:-}" = --guard-test ]; then python3 -c "$GUARD_PY"; exit 0; fi
[ $# -ge 4 ] || { echo "usage: agent-send <session> <pane> <from> <message...>" >&2; exit 2; }
S=$1; P=$2; FROM=$3; shift 3; MSG="$*"
# Inbox panes: a pane where a human types (the seat) is never typed into. If $INBOX/<pane id>.inbox exists, the
# message is appended whole, newlines kept, as one JSON line to $INBOX/<pane id>.log; `agent-inbox` renders it in a
# sidecar, and the seat's agent reads it when it works. Write structure freely: line breaks and lists survive.
# Inboxes live where the agents run (hive). A marker here that names a host forwards the record to that host's log.
INBOX="${AGENT_INBOX_DIR:-$HOME/.local/state/agent-inbox}"
if [ -e "$INBOX/${P##*:}.inbox" ]; then
  id=${P##*:}; host=$(tr -d '[:space:]' < "$INBOX/$id.inbox")
  rec=$(jq -nc --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg from "$FROM" --arg msg "$MSG" '{at:$at, from:$from, msg:$msg}')
  if [ -n "$host" ]; then
    printf '%s\n' "$rec" | ssh -o BatchMode=yes -o ConnectTimeout=8 "$host" "mkdir -p ~/.local/state/agent-inbox && cat >> ~/.local/state/agent-inbox/$id.log"
  else
    printf '%s\n' "$rec" >> "$INBOX/$id.log"
  fi
  exit 0
fi
# Delivery goes through teerex send (jcbbge/teerex): one paste of "FROM <from>: <message>", then Enter, under the
# shared agent-send lock, on the server that holds the pane. teerex takes that lock itself, so this script never holds
# it. The typing guard (wait while someone is typing, then restore their draft) stays here: teerex does not do it.
. "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")/teerex-target"
resolve "$S"
draft() {
  rexat block call -s "$SID" -b "$P" format '{"format":"vt"}' 2>/dev/null | python3 -c "$GUARD_PY" || true # CHECK: C9
}
d=""
for _ in $(seq 1 30); do d=$(draft); [ -z "$d" ] && break; sleep 1; done
[ -n "$d" ] && { rexat send-key -s "$SID" -b "$P" ctrl+u >/dev/null 2>&1 || true; }
OUT=$(printf '%s' "$MSG" | tx_send "$P" "$FROM") || {
  echo "agent-send: teerex send did not confirm delivery to $P: $(tx_why send "$OUT"). Inspect the pane before resending." >&2
  exit 1; }
if [ -n "$d" ]; then
  sleep 0.4
  EV=$(jq -nc --arg s "$SID" --arg b "$P" --arg t "$d" '{session_id:$s,block_id:$b,event:{type:"paste",payload:{text:$t}}}')
  rexat api call -s "$SID" block.event "$EV" >/dev/null || true
  mkdir -p "$HOME/.local/state/agent-send"
  printf '%s %s draft restored (%s chars)\n' "$(date -u +%FT%TZ)" "$P" "${#d}" >> "$HOME/.local/state/agent-send/guard.log"
fi
