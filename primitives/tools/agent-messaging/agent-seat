#!/usr/bin/env bash
# agent-seat: mark a pane as the seat's inbox (agents never type into it) and open the inbox viewer beside it at
# one third of the width. Silent, at most once per pane, safe to run again. Called by `seat`, which is the only way
# a seat starts (Josh, 2026-11-13: one concierge per session); it no longer runs on every hive login. Agents started
# by agent-spawn carry AGENT_PANE (LC_AGENT_NAME over ssh) and are skipped.
set -euo pipefail
[ -n "${AGENT_PANE:-}${LC_AGENT_NAME:-}" ] && exit 0 # an agent (its name crosses ssh as LC_AGENT_NAME), not the human
B=${REX_BLOCK:-${LC_REX_BLOCK:-}}; S=${REX_SESSION:-${LC_REX_SESSION:-}}
[ -n "$B" ] && [ -n "$S" ] || exit 0
command -v rex >/dev/null || exit 0
id=${B##*:}; D="${AGENT_INBOX_DIR:-$HOME/.local/state/agent-inbox}"; mkdir -p "$D"
touch "$D/$id.inbox" "$D/$id.log"
# One viewer per seat: skip if the one recorded for this pane still exists.
if [ -s "$D/$id.viewer" ] && rex block ls --json 2>/dev/null | grep -q "$(cat "$D/$id.viewer")"; then exit 0; fi
tz=${AGENT_INBOX_TZ:-America/Chicago}
CMD="TZ=$tz ~/.local/bin/agent-inbox $id"
VIEW=$(rex api call -s "$S" session.view 2>/dev/null || echo '{}') # CHECK: rex api describe session.view --json (C4)
SID=$(printf '%s' "$VIEW" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("session_id",""))')
W=$(printf '%s' "$VIEW" | python3 -c '
import json,sys
bid=sys.argv[1]
def holds(n):
    return n.get("block",{}).get("block_id")==bid or any(holds(n.get("split",{}).get(k,{})) for k in ("before","after") if k in n.get("split",{}))
for w in json.load(sys.stdin).get("windows",[]):
    if any(holds(l.get("layout",{})) for l in w.get("layers",[])): print(w["window_id"]); break
' "$B")
if [ -n "${REX_SESSION:-}" ]; then ARGV=$(jq -nc --arg c "$CMD" '["sh","-lc",$c]'); else ARGV=$(jq -nc --arg c "$CMD" '["ssh","-t","hive",$c]'); fi
J=$(jq -nc --arg s "$SID" --arg w "$W" --argjson argv "$ARGV" '{session_id:$s,window_id:$w,bounds:[0.667,0,0.333,1],focus:false,layout:{block:{flavor:"com.superlogical.terminal.shell",label:"inbox",options:{command:$argv}}}}') # CHECK: rex block types --json; rex api describe session.new_layer --json (C1, C3)
if out=$(rex api call -s "$S" session.new_layer "$J" 2>>"$D/seat.log"); then
  if v=$(printf '%s' "$out" | python3 -c 'import json,sys;print(json.load(sys.stdin)["block_ids"][0])'); then
    printf '%s\n' "$v" > "$D/$id.viewer"; exit 0
  fi
fi
# Keep the previous split and resize as the fallback.
if [ -n "${REX_SESSION:-}" ]; then
  v=$(rex run -s "$S" -b "$B" --split=right --focus=false -- sh -lc "$CMD" 2>/dev/null) || exit 0
else
  v=$(rex run -s "$S" -b "$B" --split=right --focus=false -- ssh -t hive "$CMD" 2>/dev/null) || exit 0
fi
printf '%s\n' "$v" > "$D/$id.viewer"
# Size it to a third and read it back (research idea 8): retry, and log any mismatch instead of failing silently.
ratio() { rex api call session.view -s "$S" 2>/dev/null | python3 -c '
import json,sys
v,b=sys.argv[1],sys.argv[2]
def walk(n):
    s=n.get("split")
    if not s: return None
    kids=(s.get("before",{}).get("block_id"),s.get("after",{}).get("block_id"))
    if kids==(b,v): return s.get("ratio")
    return walk(s.get("before",{})) or walk(s.get("after",{}))
for w in json.load(sys.stdin).get("windows",[]):
    for l in w.get("layers",[]):
        r=walk(l.get("layout",{}))
        if r: print(r); sys.exit()' "$v" "$B"; }
for try in 1 2 3; do
  sleep 1
  rex api call session.resize_pane "{\"session_id\":\"$S\",\"direction\":\"horizontal\",\"before_block_id\":\"$B\",\"after_block_id\":\"$v\",\"ratio\":0.667}" >>"$D/seat.log" 2>&1
  r=$(ratio); case "$r" in 0.66*) exit 0 ;; esac
  echo "$(date -u +%FT%TZ) $id: ratio read back '$r' after try $try" >> "$D/seat.log"
done
