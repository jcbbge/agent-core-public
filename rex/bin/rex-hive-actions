#!/usr/bin/env python3
"""Generate the Hive palette only when every launch-menu line is understood."""
from pathlib import Path
import re
import sys


def lua_str(text):
    return '"' + ''.join('\\' + c if c in '\\"' else ('\\%03d' % ord(c)) if ord(c) < 32 or ord(c) == 127 else c for c in text) + '"'


def main():
    config = Path.home() / '.config/hive'
    override = config / 'actions.tsv'
    source = override if override.exists() else config / 'launch'
    try:
        lines = source.read_text().splitlines()
    except OSError as error:
        print(error, file=sys.stderr)
        return 2
    entries, bad = [], []
    for line in lines:
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        if source == override:
            parts = line.split('\t', 2)
            if len(parts) == 3 and all(x.strip() for x in parts):
                entries.append(parts)
                continue
        else:
            match = re.fullmatch(r'\s*([\w-]+)\s*\)\s*(.+?)\s*;;\s*', line)
            if not match:
                match = re.fullmatch(r'\s*([\w-]+)(?:\t|\s*[=:]\s*)(.+?)\s*', line)
            if match:
                name, command = match.groups()
                title = re.sub('[-_]', ' ', name)
                entries.append((name, title[:1].upper() + title[1:], command))
                continue
        bad.append(line)
    slugs = set()
    for name, _, _ in entries:
        slug = re.sub('[^a-z0-9]', '_', name.lower())
        if slug in slugs:
            bad.append('duplicate action slug: ' + slug)
        slugs.add(slug)
    if bad or not entries:
        print('\n'.join(bad) or f'{source}: no actions parsed', file=sys.stderr)
        return 2
    for name, title, command in entries:
        slug = re.sub('[^a-z0-9]', '_', name.lower())
        print('rex.action{ name = %s, title = %s, category = "Hive", keywords = %s, run = function(ctx) return HIVE.open(ctx, %s, %s) end }' % tuple(map(lua_str, ('hive_' + slug, title, name + ' ' + command, command, title))))
    return 0

if __name__ == '__main__':
    sys.exit(main())
