#!/usr/bin/env python3
"""Record Rex state changes durably, or show the recent agent history."""
import argparse
import base64
import datetime as dt
import json
import os
from pathlib import Path
import subprocess
import sys
import time

STATE = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'rex-flight'

def message(value):
    if not isinstance(value, str) or any(c.isspace() for c in value):
        return value
    try:
        decoded = base64.b64decode(value, validate=True).decode('utf-8')
        if decoded and all(c.isprintable() for c in decoded):
            return decoded
    except (ValueError, UnicodeError):
        pass
    return value


def record(args):
    command = '/usr/bin/rex' if args.server == 'hive' else 'rex'
    child = None
    labels, refreshed = {}, -float('inf')
    def label(bid):
        nonlocal refreshed
        if bid not in labels and time.monotonic() - refreshed >= 10:
            refreshed = time.monotonic()
            try:
                # `rex block ls --json` needs one session, so walk every session through the API.
                blocks = []
                for sess in json.loads(subprocess.check_output([command, 'api', 'call', 'session.list'], timeout=8)).get('sessions', []):
                    out = subprocess.check_output([command, 'api', 'call', '-s', sess['session_id'], 'session.list_blocks'], timeout=8)
                    blocks += json.loads(out).get('blocks', [])
                labels.update({b['block_id']: b.get('label', '') for b in blocks})
            except (OSError, ValueError, subprocess.SubprocessError, KeyError, TypeError):
                pass
        return labels.get(bid, '')
    try:
        if args.stdin:
            stream = sys.stdin
        else:
            child = subprocess.Popen([command, 'events', '--all', '--json'], stdout=subprocess.PIPE, text=True)
            stream = child.stdout
        STATE.mkdir(parents=True, exist_ok=True)
        for line in stream:
            try:
                outer = json.loads(line)
                if outer.get('type') != 'session_event':
                    continue
                payload = outer['payload']
                event = payload['event']
                name = event.get('type')
                data = event.get('payload', {})
                bid = data.get('block_id')
                status, sub = {}, None
                if name == 'block_event':
                    if data.get('creator_name') != 'com.superlogical.terminal':
                        continue
                    name = data.get('name')
                    data = data.get('payload', {})
                    if name not in ('program_status_changed', 'program_status_removed', 'child_exited'):
                        continue
                    # CHECK: rex api describe com.superlogical.terminal.program_status --json; C6/C7
                    status = data.get('record') or {}
                    sub = data.get('id') or status.get('id')
                elif name not in ('block_created', 'block_closed'):
                    continue
                now = dt.datetime.now(dt.timezone.utc)
                rec = dict(at=now.isoformat(), server=args.server, session=payload.get('session_id'), block=bid,
                           agent=label(bid), event=name, state=status.get('state'), kind=status.get('kind'),
                           app=status.get('app'), msg=message(status.get('msg')), exit_code=data.get('exit_code'),
                           reason=data.get('reason'), sub=sub)
                if name == 'program_status_removed' and data.get('ids'):
                    rec['sub'] = data['ids']
                rec = {k: v for k, v in rec.items() if v is not None and v != ''}
                with (STATE / (now.date().isoformat() + '.jsonl')).open('a') as out:
                    out.write(json.dumps(rec, ensure_ascii=False) + '\n')
                    out.flush()
                if name == 'block_closed':
                    labels.pop(bid, None)
            except (ValueError, KeyError, TypeError):
                continue
    finally:
        if child:
            child.terminate()
            child.wait()
    return 0 if args.stdin else 1


def show(args):
    records = []
    today = dt.datetime.now(dt.timezone.utc).date()
    for date in (today - dt.timedelta(days=1), today):
        path = STATE / (date.isoformat() + '.jsonl')
        if not path.exists():
            continue
        for line in path.read_text().splitlines():
            try:
                rec = json.loads(line)
                if not args.name or rec.get('agent') == args.name:
                    records.append(rec)
            except ValueError:
                continue
    for rec in records[-args.n:] if args.n > 0 else []:
        print(f"{rec['at'][11:19]}  {rec.get('agent', '')}  {rec.get('state') or rec['event']}  {rec.get('msg', '')}")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    rec = commands.add_parser('record')
    rec.add_argument('--server', choices=('mac', 'hive'), default='mac')
    rec.add_argument('--stdin', action='store_true', help=argparse.SUPPRESS)
    view = commands.add_parser('show')
    view.add_argument('name', nargs='?')
    view.add_argument('-n', type=int, default=20)
    args = parser.parse_args()
    return record(args) if args.command == 'record' else show(args)

if __name__ == '__main__':
    sys.exit(main())
